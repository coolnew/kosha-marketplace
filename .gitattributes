# Normalize text to LF in Git and in every working tree, including Windows.
* text=auto eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.png binary
*.jpg binary
*.gif binary
*.zip binary
*.pdf binary
